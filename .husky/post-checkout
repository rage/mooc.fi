#!/bin/sh

# $3 is 0 for file checkouts, which cannot change the lockfile.
[ "$3" = "1" ] || exit 0
# Checkouts of commits from before the pnpm switch (old branches, worktrees) lack the script.
[ -f .husky/ensure-dependencies-up-to-date.ts ] || exit 0

. "$(dirname "$0")/ensure-dev-path.sh"

node .husky/ensure-dependencies-up-to-date.ts
