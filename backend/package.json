    "tmc-client-js": "^0.0.11",
    "tsx": "^4.23.15",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1"
