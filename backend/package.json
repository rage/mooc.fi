  "scripts": {
    "test": "TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest",
    "test:ci": "TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --ci --runInBand --coverage",
    "test-update-snapshots": "TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --updateSnapshot",
    "upgrade-interactive": "pnpm up --interactive --latest",
    "fetch-ai-completions": "node ./dist/bin/fetchAiCompletions.js",
    "fetch-organizations": "node ./dist/bin/importOrganizations.js",
    "fetch-user-app-datum": "node ./dist/bin/fetchUserAppDatum.js",
    "fetch-user-field-values": "node ./dist/bin/fetchUserFieldValues.js",
    "fetch-avoin-links": "node ./dist/bin/fetchAvoinLinks.js",
    "sync-tmc-users": "node ./dist/bin/syncTMCUsers.js",
    "send-ai-statistics": "node ./dist/bin/sendAiStatistics.js",
    "course-stats-emailer": "node ./dist/bin/courseStatsEmailer.js",
    "linkoping-stats-emailer": "node ./dist/bin/linkopingStatsEmailer.js",
    "prague-stats-emailer": "node ./dist/bin/pragueStatsEmailer.js",
    "opava-stats-emailer": "node ./dist/bin/opavaStatsEmailer.js",
    "purkyne-stats-emailer": "node ./dist/bin/purkyneStatsEmailer.js",
    "masaryk-stats-emailer": "node ./dist/bin/masarykStatsEmailer.js",
    "elements-consented-users-emailer": "node ./dist/bin/elementsConsentedUsersEmailer.js",
    "import-organizations": "node ./dist/bin/importOrganizations.js",
    "parse-file": "node ./dist/bin/parseFile.js",
    "start-kafka-consumers": "concurrently --kill-others --restart-tries 2 'pnpm:kafka-consumer-*'",
    "kafka-consumer-user-course-progress-batch": "node ./dist/bin/kafkaConsumer/userCourseProgressConsumer/kafkaConsumer.js",
    "kafka-consumer-user-course-progress-realtime": "node ./dist/bin/kafkaConsumer/userCourseProgressRealtimeConsumer/kafkaConsumer.js",
    "kafka-consumer-user-points-batch": "node ./dist/bin/kafkaConsumer/userPointsConsumer/kafkaConsumer.js",
    "kafka-consumer-user-points-realtime": "node ./dist/bin/kafkaConsumer/userPointsRealtimeConsumer/kafkaConsumer.js",
    "kafka-consumer-user-course-points-batch": "node ./dist/bin/kafkaConsumer/userCoursePointsConsumer/kafkaConsumer.js",
    "kafka-consumer-user-course-points-realtime": "node ./dist/bin/kafkaConsumer/userCoursePointsRealtimeConsumer/kafkaConsumer.js",
    "kafka-consumer-exercises": "node ./dist/bin/kafkaConsumer/exerciseConsumer/kafkaConsumer.js",
    "generate": "pnpm run generate:prisma && pnpm run generate:nexus",
    "generate:prisma": "prisma generate",
    "generate:nexus": "NEXUS_REFLECTION=true NODE_ENV=production tsx ./schema/common/createSchema.ts",
    "kafka-status": "node ./dist/bin/kafkaStatus.js",
    "seed": "node ./dist/bin/seed.js",
    "seedAll": "pnpm run seed && pnpm run seedPoints && pnpm run seedExercises && pnpm run seedCompletions",
    "seedPoints": "node ./dist/bin/seedPoints.js",
    "seedExercises": "node ./dist/bin/seedExercises.js",
    "seedCompletions": "node ./dist/bin/seedCompletions.js",
    "createExports": "node ./bin/createExports.js",
    "kafka-bridge": "node ./dist/bin/kafkaBridge.js",
    "background-emailer": "node ./dist/bin/backgroundEmailer.js",
    "update-course-statuses": "node ./dist/bin/updateCourseStatuses.js",
    "remove-duplicate-exercise-completions": "node ./dist/bin/removeDuplicateExerciseCompletions.js",
    "expire-user-organization-join-confirmations": "node ./dist/bin/expireUserOrganizationJoinConfirmations.js",
    "prune-old-stored-data": "node ./dist/bin/pruneOldStoredData.js",
    "download-env": "node ./bin/downloadEnv.js",
    "dev": "pnpm run download-env && tsx watch --clear-screen=false ./app.ts",
    "dev:typecheck": "tsc --noEmit --watch",
    "build": "pnpm run download-env && pnpm run createExports && tsc --noEmit false && cp -R types generated dist",
    "start": "node dist/app.js",
    "copy-env": "cp ./config/env.json ./dist/config/env.json",
    "migrate": "NODE_OPTIONS=\"--import tsx\" knex migrate:latest",
    "rollback": "NODE_OPTIONS=\"--import tsx\" knex migrate:rollback",
    "build-sourcemap": "tsc --noEmit false --sourceMap --outDir sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
