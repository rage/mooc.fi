    "@types/pg": "^8.23.1",
    "@types/serve-static": "^2.2.0",
    "@types/shortid": "^2.2.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "graphql-request": "^7.4.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jest-snapshot": "^30.5.2",
