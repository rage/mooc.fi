{
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["es2016", "esnext"],
    "target": "es6",
    "module": "node20",
    "outDir": "./dist",
    "isolatedModules": true,
    "types": ["node", "jest"],
    "strict": true,
    "noEmit": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    // https://github.com/redis/node-redis/issues/3009
    "skipLibCheck": true
  },
  "include": ["."],
  "exclude": ["node_modules", "dist", "sourcemap", "coverage"]
}
